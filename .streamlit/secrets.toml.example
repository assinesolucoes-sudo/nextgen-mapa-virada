# Renomeie/copie pra .streamlit/secrets.toml localmente,
# OU cole este conteúdo em "Settings > Secrets" no Streamlit Community Cloud.
# NUNCA suba o arquivo real (com a chave) pro GitHub.

[app]
sheet_url = "https://docs.google.com/spreadsheets/d/COLOQUE_O_ID_DA_SUA_PLANILHA/edit"
admin_key = "elaine"   # o ?admin=elaine usa este valor

[gcp_service_account]
type = "service_account"
project_id = "seu-projeto"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "mapa-virada@seu-projeto.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
